[Desktop Entry]
Type=Application
Name=ProCam
Icon=procam-sfos
Exec=/usr/bin/procam
Comment=ProCam

[X-Sailjail]
ApplicationName=procam
OrganizationName=com.procam
DataDirectory=procam
Permissions=Camera;Audio;Microphone;Pictures;Videos;MediaIndexing;Location;Privileged;Ambience;RemovableMedia
