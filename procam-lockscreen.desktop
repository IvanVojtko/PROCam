[Desktop Entry]
Type=Application
NoDisplay=true
Name=ProCam
Icon=procam-sfos
Exec=/usr/bin/invoker --type=silica-media,silica-qt5 -A -- /usr/bin/procam-lockscreen
Comment=ProCam

[X-Sailjail]
ApplicationName=procam-lockscreen
OrganizationName=com.procam
DataDirectory=procam
Permissions=Camera;Audio;Microphone;Pictures;Videos;MediaIndexing;Location;Privileged;RemovableMedia
